<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    
    <AssemblyName>OpenSpecification.EntityFrameworkCore</AssemblyName>
    <PackageId>OpenSpecification.EntityFrameworkCore</PackageId>
    <Title>OpenSpecification.EntityFrameworkCore</Title>
    <Description>EF Core plugin package to OpenSpecification containing EF Core evaluator and abstract repository.</Description>
    <Summary>EF Core plugin package to OpenSpecification containing EF Core evaluator and abstract repository.</Summary>
    
    <Version>10.0.0</Version>
    <PackageTags>spec;specification;repository;ddd;ef;ef core;entity framework;entity framework core</PackageTags>
    <PackageReleaseNotes>
      The change log and breaking changes are listed here.
      https://github.com/bandoyer/OpenSpecification/blob/main/CHANGELOG.md
    </PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore"/>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenSpecification\OpenSpecification.csproj" />
  </ItemGroup>
  
</Project>
