<Project Sdk="Microsoft.NET.Sdk">

  <!-- verify efcore-consumer writes this as Consumer.csproj, pointing the ProjectReference at a tree's EF Core provider
       project, and taking the SQL Server provider's version from that tree's Directory.Packages.props. For a tree whose
       DbSet extensions have #11's methods, it adds DBSET_READS to DefineConstants, and for a tree whose
       IReadRepositoryBase<T> has #16's AsAsyncEnumerable<TResult>, PROJECTED_ASYNC_ENUMERABLE, so the lines that call
       them build only against a tree that has them. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>13.0</LangVersion>
    <DefineConstants>$(DefineConstants)@DEFINES@</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="@SQLSERVER@" />
    <ProjectReference Include="@PROVIDER@" />
  </ItemGroup>

</Project>
