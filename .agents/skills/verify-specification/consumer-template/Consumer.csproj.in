<Project Sdk="Microsoft.NET.Sdk">

  <!-- verify consumer writes this as Consumer.csproj, pointing the ProjectReference at a tree's EF6 provider project.
       For a tree whose DbSet extensions have #11's methods, it adds DBSET_READS to DefineConstants, so the lines that
       call them build only against a tree that has them. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>13.0</LangVersion>
    <DefineConstants>$(DefineConstants)@DEFINES@</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="@PROVIDER@" />
  </ItemGroup>

</Project>
