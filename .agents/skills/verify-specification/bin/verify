#!/usr/bin/env bash
# verify: builds and runs a consumer of the EF6 or EF Core provider, the way a project that references the package does.
# `verify help` lists the commands. Everything it makes lives under one scratch root on /tmp.
set -euo pipefail

SKILL_DIR=$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/.." && pwd)
REPO_ROOT=$(git -C "$SKILL_DIR" rev-parse --show-toplevel)
# The guard test sets its own root; any root must be a folder directly in /tmp named verify-specification-*.
SCRATCH=${VERIFY_SPECIFICATION_SCRATCH:-/tmp/verify-specification-$(id -u)}
MARKER=.verify-made
LOCK="$HOME/.cache/specification-spec-sql.lock"
# CONTRIBUTING.md's spec-sql container, used when SPECIFICATION_TEST_SQL_SERVER is unset.
DEFAULT_SQL='Server=localhost,1433;User Id=sa;Password=P@ssW0rd!;TrustServerCertificate=True'

die() { echo "verify: $*" >&2; exit 2; }

[[ $SCRATCH == /tmp/verify-specification-* && ${SCRATCH#/tmp/} != */* ]] \
    || die "refused: the scratch root $SCRATCH is not /tmp/verify-specification-<something>"

usage() {
    cat <<EOF
verify doctor                    check the SDK, the SQL Server port, the lock, and the scratch items
verify tree <git ref>            export that commit of this repository into the scratch root; prints its folder
verify library <tree>            print the tree's library name: OpenSpecification, or Ardalis.Specification before #47
verify consumer <tree> [<name>]  make a consumer project that references the tree's EF6 provider; prints its folder
verify efcore-consumer <tree> [<name>]
                                 make a consumer project that references the tree's EF Core provider; prints its folder
verify pack <tree>               pack the tree's packages in Release into <tree>/feed; prints the feed, then each package
verify package-consumer <tree> <template> [<name>]
                                 make a consumer from package-consumer-templates/<template>/, whose NuGet.config restores
                                 from the tree's feed and nuget.org into the consumer's own packages/; prints its folder
verify build <consumer>          build the consumer; prints each distinct warning and each probe's warnings
verify run <consumer>            run the consumer against SQL Server under the shared lock; prints one line per query
verify warnings <tree>/<path>.csproj [-p:Nullable=<value>]
                                 build a project inside a tree; prints each distinct warning with its frameworks
verify benchmark <tree> <folder> <method>...
                                 run <folder>/Program.cs, a BenchmarkDotNet workload, against the tree's EF6 provider;
                                 keeps its logs in <folder>/results-<sha>/, and fails unless each method has allocations
verify benchmark compare <base tree> <branch tree> <folder> <workload>...
                                 run it with the files <folder>/base-files lists compiled in from the base, as MergeBase;
                                 fails unless each workload has allocations, and the branch's Ratio and RatioSD
verify cleanup [<item>...]       remove the named scratch items, or every one; never touches anything else
Scratch root: $SCRATCH
EOF
}

# Prints the resolved path when $2 is a scratch item this helper made: one folder directly under the root's trees/
# or consumers/ (the kind $1 names, or either for "any"), holding the marker. Otherwise says why and returns 1.
check_item() {
    local kind=$1 path=$2 root resolved rest top name
    if [[ ! -d $SCRATCH || -L $SCRATCH || ! -O $SCRATCH ]]; then
        echo "verify: refused: the scratch root $SCRATCH is missing, a link, or another user's" >&2
        return 1
    fi
    root=$(realpath -m -- "$SCRATCH")
    resolved=$(realpath -m -- "$path")
    rest=${resolved#"$root"/}
    top=${rest%%/*}
    name=${rest#*/}
    if [[ $resolved != "$root"/* || $rest != */* || -z $name || $name == */* ]] \
        || [[ $top != trees && $top != consumers ]] || [[ $kind != any && $kind != "$top" ]]; then
        echo "verify: refused: $path is not a folder directly under $root/${kind/any/trees or consumers}" >&2
        return 1
    fi
    if [[ ! -e $resolved ]]; then
        echo "verify: refused: $path doesn't exist; the helper removes items older than a day, so make it again" >&2
        return 1
    elif [[ ! -d $resolved || ! -f $resolved/$MARKER ]]; then
        echo "verify: refused: $path has no $MARKER marker, so this helper didn't make it" >&2
        return 1
    fi
    printf '%s\n' "$resolved"
}

item() { check_item "$@" || exit 2; }

remove_item() {
    local dir
    dir=$(check_item any "$1") || return 1
    rm -rf -- "$dir"
    echo "removed $dir"
}

# Makes the scratch root, then removes this helper's items there that are older than a day.
ensure_scratch() {
    if [[ -e $SCRATCH || -L $SCRATCH ]]; then
        [[ -d $SCRATCH && ! -L $SCRATCH && -O $SCRATCH ]] || die "refused: $SCRATCH is not a folder this user owns"
    else
        mkdir -m 700 "$SCRATCH"
    fi
    mkdir -p "$SCRATCH/trees" "$SCRATCH/consumers"
    local marker
    while IFS= read -r -d '' marker; do
        remove_item "$(dirname "$marker")" >/dev/null 2>&1 || true
    done < <(find "$SCRATCH/trees" "$SCRATCH/consumers" -mindepth 2 -maxdepth 2 -name "$MARKER" -mtime +0 -print0)
}

# Prints each distinct warning in the build log $1 once, with the frameworks it appeared in, then the count. Every line
# holding ": warning " counts, in the form "<file>(<line>,<col>): warning <code>: <message> [<project>]" with or without
# the position, the code or the project, as compilers, NuGet and MSBuild targets write them.
report_warnings() {
    awk -v prefix="$(realpath -m -- "$SCRATCH")/" '
        {
            at = index($0, ": warning ")
            if (at == 0) next
            place = substr($0, 1, at - 1)
            rest = substr($0, at + 10)
            code = "(no code)"
            message = rest
            if (match(rest, /^[^ :]*:/)) {
                if (RLENGTH > 1) code = substr(rest, 1, RLENGTH - 1)
                message = substr(rest, RLENGTH + 1)
            }
            sub(/^ +/, "", message)
            tfm = ""
            if (match(message, / \[[^]]*\]$/)) {
                project = substr(message, RSTART + 2, RLENGTH - 3)
                message = substr(message, 1, RSTART - 1)
                if (match(project, /TargetFramework=.*/)) tfm = substr(project, RSTART + 16)
            }
            sub(/^[ \t]+/, "", place)
            sub(/ +$/, "", place)
            if (match(place, /\([0-9]+(,[0-9]+)*\)$/)) {
                line = substr(place, RSTART + 1, RLENGTH - 2)
                sub(/,.*/, "", line)
                place = substr(place, 1, RSTART - 1) ":" line
            }
            if (index(place, prefix) == 1) place = substr(place, length(prefix) + 1)
            key = place " " code " " message
            if (!(key in tfms)) { order[++n] = key; tfms[key] = "" }
            if (tfm != "" && index("," tfms[key] ",", "," tfm ",") == 0) tfms[key] = tfms[key] (tfms[key] == "" ? "" : ",") tfm
        }
        END {
            for (i = 1; i <= n; i++) printf "warning %s%s\n", order[i], (tfms[order[i]] == "" ? "" : " [" tfms[order[i]] "]")
            printf "warnings: %d\n", n
        }' "$1"
}

# For each "// PROBE <tag>: <codes>" line in the consumer $2's probe files, Probes.cs and then any other *Probes.cs,
# prints the warnings the build log $1 has there. A consumer holds only the probe files its tree supports, so every
# PROBE line counts.
report_probes() {
    local log=$1 file name n line got
    for file in "$2/Probes.cs" "$2"/?*Probes.cs; do
        [[ -f $file ]] || continue
        name=$(basename "$file") n=0
        while IFS= read -r line; do
            n=$((n + 1))
            # An editor that follows .editorconfig saves the file with CRLF endings, which the codes mustn't keep.
            line=${line%$'\r'}
            [[ $line =~ //\ PROBE\ ([a-z0-9-]+):\ (.*)$ ]] || continue
            got=$(sed -nE "s/^.*\/${name//./\\.}\($n,[0-9]+\): warning ([A-Z]+[0-9]+):.*/\1/p" "$log" | sort -u | paste -sd, -)
            printf 'probe %s (%s:%d): got %s; an annotated provider gives %s\n' \
                "${BASH_REMATCH[1]}" "$name" "$n" "${got:-none}" "${BASH_REMATCH[2]}"
        done < "$file"
    done
}

cmd_doctor() {
    local failed=0 conn server host port entry
    if dotnet --list-sdks 2>/dev/null | grep -qE '^(9|[1-9][0-9])\.'; then
        echo "ok: a .NET SDK 9 or later"
    else
        echo "fail: no .NET SDK 9 or later on PATH"; failed=1
    fi
    echo "ok: repository $REPO_ROOT at $(git -C "$REPO_ROOT" rev-parse --short=12 HEAD)"
    conn=${SPECIFICATION_TEST_SQL_SERVER:-$DEFAULT_SQL}
    server=$(tr ';' '\n' <<<"$conn" | sed -nE 's/^[[:space:]]*(server|data source|address|addr)[[:space:]]*=[[:space:]]*(tcp:)?//Ip' | head -1)
    host=${server%%,*}
    port=1433
    [[ $server == *,* ]] && port=${server##*,}
    if timeout 3 bash -c "exec 3<>/dev/tcp/$host/$port" 2>/dev/null; then
        echo "ok: SQL Server accepts connections on $host:$port (the first run checks the login)"
    else
        echo "fail: nothing accepts connections on $host:$port; start spec-sql as CONTRIBUTING.md shows"; failed=1
    fi
    if [[ -d $(dirname "$LOCK") ]]; then
        echo "ok: the shared lock is $LOCK"
    else
        echo "fail: $(dirname "$LOCK") is missing, so the shared lock can't be taken"; failed=1
    fi
    if [[ ! -e $SCRATCH ]]; then
        echo "ok: no scratch root yet; the first tree makes $SCRATCH"
    elif [[ -d $SCRATCH && ! -L $SCRATCH && -O $SCRATCH ]]; then
        echo "ok: scratch root $SCRATCH"
        for entry in "$SCRATCH"/trees/* "$SCRATCH"/consumers/*; do
            [[ -f $entry/$MARKER ]] && echo "  ${entry#"$SCRATCH"/} from $(head -1 "$entry/$MARKER")"
        done
    else
        echo "fail: $SCRATCH is not a folder this user owns"; failed=1
    fi
    return $failed
}

cmd_tree() {
    [[ $# -eq 1 ]] || die "usage: verify tree <git ref>"
    local sha dir
    sha=$(git -C "$REPO_ROOT" rev-parse --verify --quiet "$1^{commit}") || die "no commit named $1"
    ensure_scratch
    dir="$SCRATCH/trees/${sha:0:12}"
    if [[ -e $dir || -L $dir ]]; then
        item trees "$dir" >/dev/null
    else
        mkdir "$dir"
        git -C "$REPO_ROOT" archive "$sha" | tar -x -C "$dir"
        printf '%s\n' "$sha" > "$dir/$MARKER"
    fi
    printf '%s\n' "$dir"
}

# Prints the library name of the tree $1: OpenSpecification, the name #47 gave the projects, folders and namespaces, or
# Ardalis.Specification for a tree from before #47, such as an older merge base.
library_name() {
    if [[ -f $1/src/OpenSpecification/OpenSpecification.csproj ]]; then
        echo OpenSpecification
    elif [[ -f $1/src/Ardalis.Specification/Ardalis.Specification.csproj ]]; then
        echo Ardalis.Specification
    else
        die "$1 has neither src/OpenSpecification/OpenSpecification.csproj nor src/Ardalis.Specification/Ardalis.Specification.csproj"
    fi
}

cmd_library() {
    [[ $# -eq 1 ]] || die "usage: verify library <tree>"
    library_name "$(item trees "$1")"
}

cmd_consumer() {
    [[ $# -eq 1 || $# -eq 2 ]] || die "usage: verify consumer <tree> [<name>]"
    make_consumer consumer-template EntityFramework6 EF6 "$@"
}

cmd_efcore_consumer() {
    [[ $# -eq 1 || $# -eq 2 ]] || die "usage: verify efcore-consumer <tree> [<name>]"
    make_consumer efcore-consumer-template EntityFrameworkCore "EF Core" "$@"
}

# Makes the consumer consumers/<name> from the template folder $1, referencing the provider project src/<library>.$2 of
# the tree $4, which errors call the $3 provider. The templates import OpenSpecification; for a tree from before #47,
# whose library is Ardalis.Specification, the consumer's copies of them name Ardalis.Specification instead. The name $5 defaults to the tree's short sha. The template's Consumer.csproj.in
# names the provider @PROVIDER@, and may name @SQLSERVER@, the version of Microsoft.EntityFrameworkCore.SqlServer in the
# tree's Directory.Packages.props. @DEFINES@ holds ;DBSET_READS when the tree has #11's DbSet extensions, which the
# consumer's DBSET_READS lines call, and ;PROJECTED_ASYNC_ENUMERABLE when IReadRepositoryBase<T> has #16's
# AsAsyncEnumerable<TResult>, which its PROJECTED_ASYNC_ENUMERABLE lines call. For a tree with the DbSet extensions it
# also copies the template's with-dbset-reads/ files. Every consumer also gets consumer-shared/'s files.
make_consumer() {
    local template=$SKILL_DIR/$1 suffix=$2 label=$3 tree library project name dir provider sqlserver defines= dbset_reads= old
    shift 3
    # First, so its removal of day-old items can't take the tree this checks.
    ensure_scratch
    tree=$(item trees "$1")
    library=$(library_name "$tree")
    project=$library.$suffix
    name=${2:-$(basename "$tree")}
    [[ $name =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "refused: the name $name must be letters, digits, dots, dashes or underscores"
    provider="$tree/src/$project/$project.csproj"
    [[ -f $provider ]] || die "$tree has no $label provider project"
    sqlserver=$(sed -nE 's/.*<PackageVersion Include="Microsoft\.EntityFrameworkCore\.SqlServer" Version="([^"]+)".*/\1/p' "$tree/Directory.Packages.props" 2>/dev/null | head -1) || true
    if grep -q @SQLSERVER@ "$template/Consumer.csproj.in" && [[ -z $sqlserver ]]; then
        die "$tree's Directory.Packages.props names no Microsoft.EntityFrameworkCore.SqlServer version"
    fi
    grep -q FirstOrDefaultAsync "$tree/src/$project/Extensions/DbSetExtensions.cs" 2>/dev/null && dbset_reads=1 defines=';DBSET_READS'
    grep -q 'AsAsyncEnumerable<TResult>' "$tree/src/$library/IReadRepositoryBase.cs" 2>/dev/null \
        && defines+=';PROJECTED_ASYNC_ENUMERABLE'
    dir="$SCRATCH/consumers/$name"
    if [[ -e $dir || -L $dir ]]; then
        old=$(item consumers "$dir")
        rm -rf -- "$old"
    fi
    mkdir "$dir"
    cp "$template"/*.cs "$SKILL_DIR"/consumer-shared/*.cs "$dir/"
    [[ -z $dbset_reads ]] || cp "$template"/with-dbset-reads/*.cs "$dir/"
    [[ $library == OpenSpecification ]] || sed -i 's/\bOpenSpecification\b/Ardalis.Specification/g' "$dir"/*.cs
    sed -e "s|@PROVIDER@|$provider|" -e "s|@SQLSERVER@|$sqlserver|" -e "s|@DEFINES@|$defines|" \
        "$template/Consumer.csproj.in" > "$dir/Consumer.csproj"
    printf 'tree %s\n' "$(head -1 "$tree/$MARKER")" > "$dir/$MARKER"
    printf '%s\n' "$dir"
}

cmd_pack() {
    [[ $# -eq 1 ]] || die "usage: verify pack <tree>"
    local tree status=0
    ensure_scratch
    tree=$(item trees "$1")
    rm -rf -- "$tree/feed"
    dotnet pack "$tree/ci.slnf" -c Release -o "$tree/feed" -nologo -tl:off > "$tree/pack.log" 2>&1 || status=$?
    if [[ $status -ne 0 ]]; then
        grep -E ': error ' "$tree/pack.log" | sort -u >&2 || true
        die "pack failed with exit $status; see $tree/pack.log"
    fi
    printf '%s\n' "$tree/feed"
    (cd "$tree/feed" && ls -1)
}

# Makes consumers/<name>, which defaults to the template's name, from package-consumer-templates/<template>/, whose
# Consumer.csproj references packages, and adds a NuGet.config. Its restore reads the tree's feed from verify pack, then nuget.org, into the consumer's own packages/ folder, so a package
# packed again under the same version is never read from ~/.nuget/packages, and an unpublished one never lands there.
cmd_package_consumer() {
    [[ $# -eq 2 || $# -eq 3 ]] || die "usage: verify package-consumer <tree> <template> [<name>]"
    local tree template name=${3:-$2} dir old
    ensure_scratch
    tree=$(item trees "$1")
    [[ $2 =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && -f $SKILL_DIR/package-consumer-templates/$2/Consumer.csproj ]] \
        || die "refused: no template $2; package-consumer-templates/ has $(cd "$SKILL_DIR/package-consumer-templates" && ls | tr '\n' ' ')"
    template=$SKILL_DIR/package-consumer-templates/$2
    [[ $name =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || die "refused: the name $name must be letters, digits, dots, dashes or underscores"
    [[ -d $tree/feed ]] || die "$tree has no feed; run verify pack $tree first"
    dir="$SCRATCH/consumers/$name"
    if [[ -e $dir || -L $dir ]]; then
        old=$(item consumers "$dir")
        rm -rf -- "$old"
    fi
    mkdir "$dir"
    cp -r "$template/." "$dir/"
    cat > "$dir/NuGet.config" <<EOF
<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <add key="globalPackagesFolder" value="packages" />
  </config>
  <packageSources>
    <clear />
    <add key="feed" value="$tree/feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
EOF
    printf 'tree %s\n' "$(head -1 "$tree/$MARKER")" > "$dir/$MARKER"
    printf '%s\n' "$dir"
}

cmd_build() {
    [[ $# -eq 1 ]] || die "usage: verify build <consumer>"
    local dir status=0
    dir=$(item consumers "$1")
    dotnet build "$dir/Consumer.csproj" --no-incremental -nologo -tl:off -clp:NoSummary > "$dir/build.log" 2>&1 || status=$?
    report_warnings "$dir/build.log"
    report_probes "$dir/build.log" "$dir"
    echo "build: exit $status"
    [[ $status -eq 0 ]] || grep -E ': error ' "$dir/build.log" | sort -u >&2
    return $status
}

cmd_run() {
    [[ $# -eq 1 ]] || die "usage: verify run <consumer>"
    local dir
    dir=$(item consumers "$1")
    dotnet build "$dir/Consumer.csproj" -nologo -tl:off -v:quiet > "$dir/run-build.log" 2>&1 \
        || { cat "$dir/run-build.log" >&2; die "the consumer doesn't build; run verify build for its warnings and errors"; }
    SPECIFICATION_TEST_SQL_SERVER=${SPECIFICATION_TEST_SQL_SERVER:-$DEFAULT_SQL} \
        flock "$LOCK" dotnet run --project "$dir/Consumer.csproj" --no-build
}

cmd_warnings() {
    [[ $# -ge 1 ]] || die "usage: verify warnings <tree>/<path>.csproj [-p:Nullable=<value>]"
    local root resolved rest tree status=0 log property
    root=$(realpath -m -- "$SCRATCH")
    resolved=$(realpath -m -- "$1")
    rest=${resolved#"$root"/trees/}
    [[ $rest != "$resolved" && $rest == */* ]] || die "refused: $1 is not inside a tree from verify tree"
    tree=$(item trees "$root/trees/${rest%%/*}")
    [[ -f $resolved && $resolved == *.csproj ]] || die "$1 is not a .csproj file"
    shift
    # Only the nullable context, so no property can move the build's output out of the tree.
    for property in "$@"; do
        [[ $property =~ ^-p:Nullable=(enable|disable|warnings|annotations)$ ]] || die "refused: $property is not -p:Nullable=<value>"
    done
    log="$tree/warnings-$(basename "$resolved" .csproj).log"
    dotnet build "$resolved" --no-incremental -nologo -tl:off -clp:NoSummary "$@" > "$log" 2>&1 || status=$?
    report_warnings "$log"
    echo "build: exit $status"
    [[ $status -eq 0 ]] || grep -E ': error ' "$log" | sort -u >&2
    return $status
}

# A size BenchmarkDotNet writes in the Allocated column, such as 656 B, or its - for none.
SIZE='^([0-9][0-9,]*(\.[0-9]+)? (B|KB|MB|GB)|-)$'

# Prints one line for each row of the method $1 in the GitHub reports after $2, holding that row's cells in the columns
# $2 names, such as Allocated,Ratio, joined by tabs. A column the report lacks reads "no <column> column".
report_cells() {
    local method=$1 columns=$2
    shift 2
    awk -F'|' -v method="$method" -v columns="$columns" '
        BEGIN { n = split(columns, want, ",") }
        /^\|/ {
            gsub(/\*\*/, "")
            for (i = 2; i < NF; i++) { cell[i] = $i; gsub(/^ +| +$/, "", cell[i]) }
            if (cell[2] == "Method") {
                for (j = 1; j <= n; j++) { at[j] = 0; for (i = 2; i < NF; i++) if (cell[i] == want[j]) at[j] = i }
                next
            }
            if (cell[2] != method) next
            line = ""
            for (j = 1; j <= n; j++) line = line (j > 1 ? "\t" : "") (at[j] ? cell[at[j]] : "no " want[j] " column")
            print line
        }' "$@"
}

# Prints BenchmarkDotNet's reports in the results folder $1, then, for each method after it, the Allocated value of
# each of its rows, or why it has none. Returns 1 unless every method has a row, and every row a size. A run that fails
# or that BenchmarkDotNet rejects writes NA, no Allocated column, or no report at all, and exits 0 all the same.
report_allocations() {
    local out=$1 method rows values failed=0
    shift
    local -a reports=("$out"/results/*-report-github.md)
    if [[ ! -f ${reports[0]} ]]; then
        for method; do echo "no allocation $method: BenchmarkDotNet wrote no report in $out/results"; done
        return 1
    fi
    cat "${reports[@]}"
    for method; do
        rows=$(report_cells "$method" Allocated "${reports[@]}")
        if [[ -z $rows ]]; then
            echo "no allocation $method: no row in the report"; failed=1; continue
        fi
        values=$(paste -sd'\t' <<<"$rows" | sed 's/\t/, /g')
        if grep -qvE "$SIZE" <<<"$rows"; then
            echo "no allocation $method: $values"; failed=1
        else
            echo "allocated $method: $values"
        fi
    done
    return $failed
}

# Like report_allocations, for each workload after $1: the allocations of its rows MergeBase_<workload> and
# Branch_<workload>, and the branch row's Ratio and RatioSD over the merge base's. Returns 1 unless each workload has
# one row of each, both with a size, and the branch row a number in Ratio and in RatioSD.
report_comparison() {
    local out=$1 workload base branch alloc ratio sd failed=0
    shift
    local -a reports=("$out"/results/*-report-github.md)
    if [[ ! -f ${reports[0]} ]]; then
        for workload; do echo "no comparison $workload: BenchmarkDotNet wrote no report in $out/results"; done
        return 1
    fi
    cat "${reports[@]}"
    for workload; do
        base=$(report_cells "MergeBase_$workload" Allocated "${reports[@]}")
        branch=$(report_cells "Branch_$workload" Allocated,Ratio,RatioSD "${reports[@]}")
        if [[ -z $base || $base == *$'\n'* || -z $branch || $branch == *$'\n'* ]]; then
            echo "no comparison $workload: MergeBase_$workload and Branch_$workload need one row each in the report"
            failed=1; continue
        fi
        IFS=$'\t' read -r alloc ratio sd <<<"$branch"
        if grep -qE "$SIZE" <<<"$base" && grep -qE "$SIZE" <<<"$alloc" \
            && [[ $ratio =~ ^[0-9]+(\.[0-9]+)?$ && $sd =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
            echo "compare $workload: allocated $base, then $alloc; Ratio $ratio, RatioSD $sd"
        else
            echo "no comparison $workload: allocated $base, then $alloc; Ratio $ratio, RatioSD $sd"; failed=1
        fi
    done
    return $failed
}

# Makes the scratch item consumers/$3 holding the workload folder $2's Program.cs and a project that references the tree
# $1's provider, and the results folder $2/$4, which stays beside the workload, outside the scratch root, so cleanup
# never reaches it. Sets BENCH_DIR and BENCH_OUT.
prepare_benchmark() {
    local tree=$1 folder=$2 name=$3 results=$4 provider version old library
    [[ -f $folder/Program.cs ]] || die "$folder has no Program.cs, the workload to run"
    library=$(library_name "$tree")
    provider="$tree/src/$library.EntityFramework6/$library.EntityFramework6.csproj"
    [[ -f $provider ]] || die "$tree has no EF6 provider project"
    version=$(sed -nE 's/.*<PackageVersion Include="BenchmarkDotNet" Version="([^"]+)".*/\1/p' "$tree/Directory.Packages.props" 2>/dev/null | head -1) || true
    [[ -n $version ]] || die "$tree's Directory.Packages.props names no BenchmarkDotNet version"
    BENCH_OUT="$folder/$results"
    if [[ -e $BENCH_OUT || -L $BENCH_OUT ]]; then
        [[ -d $BENCH_OUT && ! -L $BENCH_OUT && -f $BENCH_OUT/$MARKER ]] \
            || die "refused: $BENCH_OUT exists, and has no $MARKER marker, so this helper didn't make it"
        rm -rf -- "$BENCH_OUT"
    fi
    mkdir "$BENCH_OUT"
    printf 'benchmark of tree %s\n' "$(head -1 "$tree/$MARKER")" > "$BENCH_OUT/$MARKER"
    BENCH_DIR="$SCRATCH/consumers/$name"
    if [[ -e $BENCH_DIR || -L $BENCH_DIR ]]; then
        old=$(item consumers "$BENCH_DIR")
        rm -rf -- "$old"
    fi
    mkdir "$BENCH_DIR"
    cp "$folder/Program.cs" "$BENCH_DIR/"
    sed -e "s|@PROVIDER@|$provider|" -e "s|@BENCHMARKDOTNET@|$version|" "$SKILL_DIR/benchmark-template/Benchmark.csproj.in" > "$BENCH_DIR/Benchmark.csproj"
    printf 'tree %s\n' "$(head -1 "$tree/$MARKER")" > "$BENCH_DIR/$MARKER"
}

# Runs the workload in BENCH_DIR, with BenchmarkDotNet's artifacts and the run's whole output in BENCH_OUT. No compiler
# server or MSBuild node outlives the run, BenchmarkDotNet's own builds of the workload included.
run_benchmark() {
    (cd "$BENCH_DIR" && MSBUILDDISABLENODEREUSE=1 DOTNET_CLI_USE_MSBUILD_SERVER=0 UseSharedCompilation=false \
        dotnet run -c Release -- --filter '*' --artifacts "$BENCH_OUT") > "$BENCH_OUT/run.log" 2>&1
}

cmd_benchmark() {
    if [[ ${1:-} == compare ]]; then
        shift
        cmd_compare "$@"
        return
    fi
    [[ $# -ge 3 ]] || die "usage: verify benchmark <tree> <folder> <method>..."
    local tree folder sha status=0 failed=0
    ensure_scratch
    tree=$(item trees "$1")
    folder=$(realpath -e -- "$2" 2>/dev/null) || die "$2 doesn't exist"
    shift 2
    sha=$(head -1 "$tree/$MARKER")
    prepare_benchmark "$tree" "$folder" "benchmark-${sha:0:12}" "results-${sha:0:12}"
    run_benchmark || status=$?
    report_allocations "$BENCH_OUT" "$@" || failed=1
    echo "benchmark: exit $status"
    [[ $status -eq 0 ]] || { tail -20 "$BENCH_OUT/run.log" >&2; return $status; }
    return $failed
}

# Times the merge base's code against the branch's in one process, so both see the same JIT and machine load. The
# files <folder>/base-files lists, as paths in the EF6 provider such as Evaluators/IncludeEvaluator.cs, come from the
# base tree, in the namespace MergeBase. The provider the workload references is the branch tree's, so a base from before
# #47 has its library's name, Ardalis.Specification, replaced with the branch's in each copy.
cmd_compare() {
    [[ $# -ge 4 ]] || die "usage: verify benchmark compare <base tree> <branch tree> <folder> <workload>..."
    local base branch folder file source copy name base_library branch_library base_pattern status=0 failed=0
    ensure_scratch
    base=$(item trees "$1")
    branch=$(item trees "$2")
    base_library=$(library_name "$base")
    branch_library=$(library_name "$branch")
    base_pattern=${base_library//./\\.}
    folder=$(realpath -e -- "$3" 2>/dev/null) || die "$3 doesn't exist"
    shift 3
    [[ -f $folder/base-files ]] || die "$folder has no base-files, the list of the base's provider files to compile in"
    local -a files=()
    while IFS= read -r file; do
        [[ -n $file ]] || continue
        [[ $file =~ ^[A-Za-z0-9_][A-Za-z0-9_/.-]*\.cs$ && $file != *..* ]] || die "refused: $file in base-files is not a .cs path inside the provider"
        [[ -f $base/src/$base_library.EntityFramework6/$file ]] || die "$base has no src/$base_library.EntityFramework6/$file"
        files+=("$file")
    done < "$folder/base-files"
    [[ ${#files[@]} -gt 0 ]] || die "$folder/base-files lists no file"
    name="compare-$(basename "$base")-$(basename "$branch")"
    prepare_benchmark "$branch" "$folder" "$name" "$name"
    for file in "${files[@]}"; do
        source="$base/src/$base_library.EntityFramework6/$file"
        copy="$BENCH_DIR/MergeBase/$file"
        mkdir -p "$(dirname "$copy")"
        # The provider's global usings, and its parent namespace, which the provider reaches from inside it.
        {
            sed -n 's/^\xEF\xBB\xBF//; s/^global using /using /p' "$base/src/$base_library.EntityFramework6/GlobalUsings.cs"
            echo "using $base_library;"
            sed "s/^\xEF\xBB\xBF//; s/\r$//; s/^namespace $base_pattern\.EntityFramework6;$/namespace MergeBase;/" "$source"
        } | sed "s/\b$base_pattern\b/$branch_library/g" > "$copy"
        grep -q '^namespace MergeBase;$' "$copy" || die "$file has no line namespace $base_library.EntityFramework6;"
    done
    run_benchmark || status=$?
    report_comparison "$BENCH_OUT" "$@" || failed=1
    echo "benchmark: exit $status"
    [[ $status -eq 0 ]] || { tail -20 "$BENCH_OUT/run.log" >&2; return $status; }
    return $failed
}

cmd_cleanup() {
    local entry failed=0
    if [[ $# -gt 0 ]]; then
        for entry in "$@"; do remove_item "$entry" || failed=2; done
        return $failed
    fi
    [[ -d $SCRATCH ]] || { echo "nothing to clean: $SCRATCH doesn't exist"; return 0; }
    [[ ! -L $SCRATCH && -O $SCRATCH ]] || die "refused: $SCRATCH is not a folder this user owns"
    for entry in "$SCRATCH"/trees/* "$SCRATCH"/consumers/*; do
        [[ -e $entry || -L $entry ]] || continue
        remove_item "$entry" || failed=2
    done
    rmdir "$SCRATCH/trees" "$SCRATCH/consumers" "$SCRATCH" 2>/dev/null || true
    return $failed
}

command=${1:-help}
[[ $# -gt 0 ]] && shift
case $command in
    doctor) cmd_doctor "$@" ;;
    tree) cmd_tree "$@" ;;
    library) cmd_library "$@" ;;
    consumer) cmd_consumer "$@" ;;
    efcore-consumer) cmd_efcore_consumer "$@" ;;
    pack) cmd_pack "$@" ;;
    package-consumer) cmd_package_consumer "$@" ;;
    build) cmd_build "$@" ;;
    run) cmd_run "$@" ;;
    warnings) cmd_warnings "$@" ;;
    benchmark) cmd_benchmark "$@" ;;
    cleanup) cmd_cleanup "$@" ;;
    help | -h | --help) usage ;;
    *) usage >&2; exit 2 ;;
esac
